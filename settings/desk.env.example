# The desk's one settings file: copy to settings/desk.env and set the three values. KEY=VALUE, read as text.
# A relative path is relative to this repo's folder. Paths: letters, digits and _ . / - only (the job lines refuse other signs).
# DATA_ROOT: where your market data lives in the desk's format (DATA_ROOT/lab_days). V2 ships no converter: your agent converts your data by following docs/CONVERT_YOUR_DATA_V2.md. Read only by the tools.
DATA_ROOT=data
# OUTPUT_ROOT: every run, receipt, log, job and scratch file goes here (needs about 60 GB free: the jobs stop under that floor).
OUTPUT_ROOT=out
# PYTHON: Python 3.10 or 3.11 with alarm/settings/PYTHON_PACKAGES.txt installed; a bare name is looked up on PATH.
PYTHON=python3
